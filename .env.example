# ==============================================================================
# TruthLens AI — Environment Configuration
# ==============================================================================
# All API keys and secrets stay here. Never commit your real .env file.
# Note: TruthLens AI includes a complete offline / mock mode for development,
# so you can run the entire pipeline and UI even before adding API keys!

# --- LLM Provider: Google Gemini API (Free Tier) ------------------------------
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Alternative LLM Provider: Groq (Free Tier) -------------------------------
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# --- Web Search Provider: Tavily API (Free Tier - 1,000 monthly searches) -----
# Get your free key at: https://tavily.com
TAVILY_API_KEY=

# --- Storage: PostgreSQL + pgvector (Optional) --------------------------------
# If left unset or set to 'local', TruthLens AI uses its built-in fast local
# vector storage and file-based corpus index without requiring PostgreSQL.
# DB_URL=postgresql://rag_user:admin@localhost:5432/ragdb
DB_URL=local
